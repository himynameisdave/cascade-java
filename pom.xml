<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.cascade</groupId>
  <artifactId>cascade</artifactId>
  <version>0.9.0</version>
  <packaging>jar</packaging>

  <name>Cascade</name>
  <description>Cascade issue tracker: a lightweight Jira alternative</description>
  <url>https://github.com/JoeTot/cascade-java</url>

  <licenses>
    <license>
      <name>MIT License</name>
      <url>https://opensource.org/licenses/MIT</url>
      <distribution>repo</distribution>
    </license>
  </licenses>

  <properties>
    <maven.compiler.release>17</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
  </properties>

  <!--
    This is a single-module project on purpose.

    As a multi-module reactor, the aggregator POM is what an analyzer treats as
    the project root: the modules become its direct dependencies and everything
    the modules declare is reported one level further down, as transitive. Tools
    that raise upgrade pull requests generally only touch direct dependencies,
    so that structure hid every third-party pin from them.

    Flattening to one artifact makes all of the dependencies below direct
    dependencies of the project itself. Code is still separated by package:
    com.cascade.core (domain, persistence, query, import, reporting),
    com.cascade.api (servlets, security, webhooks, scheduling) and
    com.cascade.cli (terminal client).

    Versions are declared inline as literals, with no dependencyManagement and
    no ${property} indirection, so a static read resolves every one of them and
    an automated upgrade has exactly one place to patch. They are pinned older
    than current on purpose; see "Dependency upgrade backlog" in README.md.
  -->

  <dependencies>
    <!-- JSON serialization -->
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
      <version>2.13.2</version>
    </dependency>

    <!-- java.time support -->
    <dependency>
      <groupId>com.fasterxml.jackson.datatype</groupId>
      <artifactId>jackson-datatype-jsr310</artifactId>
      <version>2.13.2</version>
    </dependency>

    <!-- CLI JSON parsing -->
    <dependency>
      <groupId>com.google.code.gson</groupId>
      <artifactId>gson</artifactId>
      <version>2.8.6</version>
    </dependency>

    <!-- collections and caching -->
    <dependency>
      <groupId>com.google.guava</groupId>
      <artifactId>guava</artifactId>
      <version>30.1.1-jre</version>
    </dependency>

    <!-- embedded database -->
    <dependency>
      <groupId>com.h2database</groupId>
      <artifactId>h2</artifactId>
      <version>2.1.210</version>
    </dependency>

    <!-- clustered cache -->
    <dependency>
      <groupId>com.hazelcast</groupId>
      <artifactId>hazelcast</artifactId>
      <version>5.1</version>
    </dependency>

    <!-- saved-filter expressions -->
    <dependency>
      <groupId>com.jayway.jsonpath</groupId>
      <artifactId>json-path</artifactId>
      <version>2.7.0</version>
    </dependency>

    <!-- JWT session tokens -->
    <dependency>
      <groupId>com.nimbusds</groupId>
