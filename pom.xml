<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.cascade</groupId>
  <artifactId>cascade-parent</artifactId>
  <version>0.9.0</version>
  <packaging>pom</packaging>

  <name>Cascade</name>
  <description>Cascade issue tracker: a lightweight Jira alternative</description>
  <url>https://github.com/JoeTot/cascade-java</url>

  <licenses>
    <license>
      <name>MIT License</name>
      <url>https://opensource.org/licenses/MIT</url>
      <distribution>repo</distribution>
    </license>
  </licenses>

  <modules>
    <module>cascade-core</module>
    <module>cascade-api</module>
    <module>cascade-cli</module>
  </modules>

  <properties>
    <maven.compiler.release>17</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

    <!--
      Dependency versions are pinned deliberately and are older than their
      current releases. See "Dependency upgrade backlog" in README.md: every
      pin below has a published advisory and an available fix, and four of them
      are fixed only in a pre-release (milestone / alpha / CR) version.
    -->

    <!-- Jakarta EE 9 platform (Servlet 5.0 / jakarta.* namespace) -->
    <jakarta.servlet.version>5.0.0</jakarta.servlet.version>
    <tomcat.version>10.0.0-M1</tomcat.version>
    <jakarta.el.version>4.0.1</jakarta.el.version>
    <jakarta.mail.version>1.6.7</jakarta.mail.version>

    <!-- serialization and configuration -->
    <jackson.version>2.13.2</jackson.version>
    <snakeyaml.version>1.30</snakeyaml.version>
    <gson.version>2.8.6</gson.version>
    <json.version>20220924</json.version>
    <json-smart.version>2.4.7</json-smart.version>

    <!-- commons and collections -->
    <guava.version>30.1.1-jre</guava.version>
    <commons-lang3.version>3.12.0</commons-lang3.version>
    <commons-text.version>1.9</commons-text.version>
    <commons-io.version>2.6</commons-io.version>
    <commons-compress.version>1.21</commons-compress.version>
    <commons-beanutils.version>1.9.3</commons-beanutils.version>
    <commons-collections.version>3.2.1</commons-collections.version>
    <commons-configuration2.version>2.7</commons-configuration2.version>

    <!-- content: markdown, sanitization, XML, CSV -->
    <commonmark.version>0.21.0</commonmark.version>
    <jsoup.version>1.15.2</jsoup.version>
    <xstream.version>1.4.19</xstream.version>
    <dom4j.version>2.1.1</dom4j.version>
    <xerces.version>2.12.0</xerces.version>
    <opencsv.version>4.6</opencsv.version>

    <!-- persistence -->
    <h2.version>2.1.210</h2.version>
    <postgresql.version>42.3.2</postgresql.version>
    <hikaricp.version>4.0.3</hikaricp.version>

    <!-- validation -->
    <hibernate-validator.version>7.0.0.Alpha1</hibernate-validator.version>

    <!-- security -->
    <shiro.version>2.0.0-alpha-2</shiro.version>
    <nimbus-jose-jwt.version>9.35</nimbus-jose-jwt.version>
    <bouncycastle.version>1.72</bouncycastle.version>

    <!-- outbound HTTP and webhooks -->
    <async-http-client.version>2.12.3</async-http-client.version>
    <netty.version>4.1.68.Final</netty.version>
    <httpclient5.version>5.1.3</httpclient5.version>

    <!-- reporting and attachments -->
    <pdfbox.version>2.0.15</pdfbox.version>
    <poi.version>5.2.2</poi.version>
    <tika.version>2.4.0</tika.version>
    <quartz.version>2.3.0</quartz.version>

    <!-- logging and CLI -->
    <slf4j.version>1.7.36</slf4j.version>
    <log4j.version>2.14.1</log4j.version>
    <logback.version>1.2.11</logback.version>
    <picocli.version>4.6.3</picocli.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>com.cascade</groupId>
        <artifactId>cascade-core</artifactId>
        <version>${project.version}</version>
      </dependency>

      <dependency>
        <groupId>jakarta.servlet</groupId>
